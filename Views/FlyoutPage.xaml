<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyAtc.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps"
    xmlns:views="using:TinyAtc.Views"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="OverlayCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style
            x:Key="DetailLabelStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="DetailValueStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Storyboard x:Name="MapCoverFadeOut" Completed="MapCoverFadeOut_Completed">
            <DoubleAnimation
                Storyboard.TargetName="MapCover"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.3" />
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="Root">
        <map:MapControl
            x:Name="Map"
            AutomationProperties.Name="Air traffic map"
            MapStyle="Blank" />

        <!--  Hides the map's light-gray clear color until the basemap's first tiles arrive  -->
        <Border
            x:Name="MapCover"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            IsHitTestVisible="False" />

        <Grid Padding="8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Toolbar  -->
            <Border Padding="12,4,4,4" Style="{StaticResource OverlayCardStyle}">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Grid Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse x:Name="LiveDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <!--  Negative margin lets the ring circle the dot without shifting the text  -->
                            <ProgressRing
                                x:Name="LoadingRing"
                                Width="16"
                                Height="16"
                                MinWidth="16"
                                MinHeight="16"
                                Margin="-4"
                                AutomationProperties.Name="Loading traffic"
                                IsActive="False" />
                        </Grid>
                        <StackPanel>
                            <TextBlock
                                x:Name="TitleText"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Tiny ATC" />
                            <TextBlock
                                x:Name="SubtitleText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Connecting to OpenSky…" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        x:Name="AirportsButton"
                        Grid.Column="1"
                        AutomationProperties.Name="Favorite airports"
                        Click="AirportsButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Favorite airports">
                        <FontIcon FontSize="16" Glyph="&#xE709;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Go to my view"
                        Click="RecenterButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Go to my view">
                        <FontIcon FontSize="16" Glyph="&#xE80F;" />
                    </Button>
                    <Button
                        x:Name="SaveViewButton"
                        Grid.Column="3"
                        AutomationProperties.Name="Save this view as my view"
                        Click="SaveViewButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Save this view as my view">
                        <FontIcon
                            x:Name="SaveViewIcon"
                            FontSize="16"
                            Glyph="&#xE718;" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        AutomationProperties.Name="Settings"
                        Click="SettingsButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                </Grid>
            </Border>

            <!--  Problems; the last good traffic stays on the map underneath  -->
            <InfoBar
                x:Name="StatusBar"
                Grid.Row="1"
                IsClosable="True"
                IsOpen="False"
                Severity="Warning" />

            <!--  Watched flights; shown when no aircraft or airport card is open  -->
            <Border
                x:Name="FavoritesCard"
                Grid.Row="3"
                Margin="0,0,0,20"
                Padding="14,10,10,10"
                Style="{StaticResource OverlayCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Watching" />
                    <StackPanel x:Name="FavoritesList" Spacing="4" />
                </StackPanel>
            </Border>

            <!--  Selected aircraft  -->
            <Border
                x:Name="PlaneCard"
                Grid.Row="3"
                Margin="0,0,0,20"
                Padding="14,10,6,12"
                Style="{StaticResource OverlayCardStyle}"
                Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PlaneTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="PlaneSubtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                            <Button
                                x:Name="FavoriteButton"
                                AutomationProperties.Name="Favorite this flight"
                                Click="FavoriteButton_Click"
                                Style="{StaticResource FlyoutIconButtonStyle}"
                                ToolTipService.ToolTip="Watch this flight: status in the tray tooltip and a notification when it lands">
                                <FontIcon x:Name="FavoriteIcon" FontSize="12" Glyph="&#xE734;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Close aircraft details"
                                Click="ClosePlaneButton_Click"
                                Style="{StaticResource FlyoutIconButtonStyle}"
                                ToolTipService.ToolTip="Close">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="0,0,8,0"
                        ColumnSpacing="12"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Altitude" />
                            <TextBlock x:Name="AltitudeText" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Ground speed" />
                            <TextBlock x:Name="SpeedText" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Vertical" />
                            <TextBlock x:Name="VerticalText" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Track" />
                            <TextBlock x:Name="HeadingText" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Squawk" />
                            <TextBlock x:Name="SquawkText" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock x:Name="DistanceLabel" Style="{StaticResource DetailLabelStyle}" Text="From you" />
                            <TextBlock x:Name="DistanceText" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!--  Airport traffic  -->
            <Border
                x:Name="AirportCard"
                Grid.Row="3"
                Margin="0,0,0,20"
                Padding="14,10,6,6"
                Style="{StaticResource OverlayCardStyle}"
                Visibility="Collapsed">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                x:Name="AirportTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="AirportSubtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Close airport traffic"
                            Click="CloseAirportButton_Click"
                            Style="{StaticResource FlyoutIconButtonStyle}"
                            ToolTipService.ToolTip="Close">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="AirportEmptyText"
                        Grid.Row="1"
                        Margin="0,0,8,6"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No arrivals, departures or ground traffic right now."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="TrafficList"
                        Grid.Row="1"
                        MaxHeight="196"
                        Margin="-14,0,0,0"
                        AutomationProperties.Name="Airport traffic"
                        IsItemClickEnabled="True"
                        ItemClick="TrafficList_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:TrafficRow">
                                <Grid
                                    Padding="0,6"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Callsign}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Detail}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
